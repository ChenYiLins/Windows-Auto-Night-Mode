<Page
    x:Class="AutoDarkModeApp.Views.ScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:AutoDarkModeApp.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid x:Name="ContentArea" Margin="{StaticResource NavigationViewPageContentMargin}">
            <StackPanel Style="{StaticResource PageBaseStackPanelStyle}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{helpers:ResourceString Name=lblScripts}" />
                <controls:SettingsCard Header="{helpers:ResourceString Name=PageScriptsToggle}">
                    <ToggleSwitch />
                </controls:SettingsCard>
                <HyperlinkButton MinWidth="120" Content="{helpers:ResourceString Name=PageScriptsButtonOpenConfig}" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{helpers:ResourceString Name=Links}" />
                <HyperlinkButton NavigateUri="" Content="{helpers:ResourceString Name=PageScriptsCardDocumentationTextBlock}"></HyperlinkButton>
                <HyperlinkButton NavigateUri="" Content="{helpers:ResourceString Name=PageScriptsCardUserRepositoryTextBlock}"></HyperlinkButton>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
